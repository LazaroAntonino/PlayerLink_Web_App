# ─────────────────────────────────────────────────────────────────────────────
# PlayerLink — Environment Variables Template
# Copy this file to .env and fill in your values: cp .env.example .env
# NEVER commit the .env file — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask / Backend ──────────────────────────────────────────────────────────
FLASK_APP=src/app.py
FLASK_DEBUG=1

# Secret key for Flask sessions & Flask-Admin (use a long random string in production)
FLASK_APP_KEY="change-this-to-a-random-secret-key"

# Database — SQLite for local dev, PostgreSQL for production
# SQLite (local, no setup needed):
DATABASE_URL=sqlite:////tmp/playerlink.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/playerlink

# ── JWT ──────────────────────────────────────────────────────────────────────
# Secret for signing JWT tokens — must be long and random in production
JWT_SECRET_KEY="change-this-to-another-random-secret"

# ── OpenAI (Find Games AI chat) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...

# ── Email / Flask-Mail ───────────────────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── URLs ─────────────────────────────────────────────────────────────────────
# Used by the password-reset email link
FRONTEND_URL=http://localhost:3000

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:3001
VITE_RAWG_KEY=your-rawg-api-key-here
